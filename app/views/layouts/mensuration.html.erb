<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Autour D'Un Soir</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Lien privé : jamais indexé, jamais archivé, jamais suivi. %>
    <meta name="robots" content="noindex, nofollow, noarchive">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag asset_path('a1soir_favicon.png'), rel: 'icon', type: 'image/png' %>
    <%= stylesheet_link_tag "fonts-public", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "vendor/bootstrap-icons-used", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "mensuration", "data-turbo-track": "reload", type: "module" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
  </head>

  <body class="mensuration-layout bg-black text-light d-flex flex-column vh-100 overflow-hidden">
    <header class="py-3">
      <div class="container-fluid ps-2 pe-3 d-flex align-items-center justify-content-between">
        <%= link_to home_path(locale: I18n.locale), class: "d-inline-block" do %>
          <%= image_tag "/images/a1soirlogo2.png",
                class: "navbar-logo mb-0 px-2",
                alt: "Autour d'un Soir",
                width: 521,
                height: 64 %>
        <% end %>
        <%= render "public/mensurations/locale_switch" %>
      </div>
    </header>

    <div class="public-scroll flex-grow-1 overflow-auto d-flex flex-column">
      <main class="container py-3 flex-grow-1 mensuration-shell" data-mensuration-shell>
        <% flash.each do |key, value| %>
          <% is_alert = key.to_s.in?(%w[alert error]) %>
          <div class="mensuration-flash <%= is_alert ? "mensuration-flash--alert" : "mensuration-flash--success" %> mb-3" role="status">
            <i class="bi bi-<%= is_alert ? "exclamation-triangle" : "check-circle-fill" %> mensuration-flash__icon" aria-hidden="true"></i>
            <span><%= value %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <footer class="public-site-footer mt-auto py-3">
      <div class="container py-1">
        <div class="row g-3">
          <div class="col-12 col-md-4">
            <h2 class="h6 text-uppercase mb-2 text-light"><%= t("mensurations.footer.address") %></h2>
            <% if @footer_texte_adresse.present? %>
              <%= link_to "https://www.google.com/maps/search/?api=1&query=#{CGI.escape("autour d'un soir 06400 cannes")}",
                    target: "_blank", rel: "noopener noreferrer",
                    class: "text-light text-decoration-none hover-link d-inline-flex align-items-start" do %>
                <i class="bi bi-geo-alt-fill me-2 small" style="margin-top: 2px;"></i>
                <span class="small fw-bold" style="line-height: 1.6;"><%= @footer_texte_adresse %></span>
                <i class="bi bi-box-arrow-up-right ms-2 opacity-75" style="font-size: 0.75rem; margin-top: 2px;"></i>
              <% end %>
            <% end %>
          </div>

          <div class="col-12 col-md-4">
            <h2 class="h6 text-uppercase mb-2 text-light"><%= t("mensurations.footer.contact") %></h2>
            <% if @footer_texte_contact.present? %>
              <p class="small fw-bold mb-0 d-flex align-items-start">
                <i class="bi bi-telephone-fill me-2" style="margin-top: 2px;"></i>
                <%= @footer_texte_contact %>
              </p>
            <% end %>
          </div>

          <div class="col-12 col-md-4">
            <h2 class="h6 text-uppercase mb-2 text-light"><%= t("mensurations.footer.boutique") %></h2>
            <%= link_to t("mensurations.footer.visit_site"), home_path(locale: I18n.locale), class: "text-light text-decoration-none hover-link small" %>
          </div>
        </div>
      </div>
      </footer>
    </div>
  </body>
</html>
