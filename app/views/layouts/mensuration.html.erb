<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title>Autour D'Un Soir</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%# Lien privé : jamais indexé, jamais archivé, jamais suivi. %>
    <meta name="robots" content="noindex, nofollow, noarchive">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= favicon_link_tag asset_path('a1soir_favicon.png'), rel: 'icon', type: 'image/png' %>
    <%= stylesheet_link_tag "fonts-public", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "vendor/bootstrap-icons-used", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "mensuration", "data-turbo-track": "reload", type: "module" %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous" defer></script>
  </head>

  <body class="mensuration-layout bg-black text-light d-flex flex-column vh-100 overflow-hidden">
    <header class="py-2">
      <div class="container-fluid ps-2 pe-3 d-flex align-items-center justify-content-between">
        <%= link_to home_path(locale: I18n.locale), class: "d-inline-block" do %>
          <%= image_tag "/images/a1soirlogo2.png",
                class: "navbar-logo mb-0 px-2",
                alt: "Autour d'un Soir",
                width: 521,
                height: 64 %>
        <% end %>
        <%= render "public/mensurations/locale_switch" %>
      </div>
    </header>

    <div class="public-scroll flex-grow-1 overflow-auto d-flex flex-column">
      <main class="public-content mensuration-shell flex-grow-1">
        <% flash.each do |key, value| %>
          <% is_alert = key.to_s.in?(%w[alert error]) %>
          <div class="mensuration-flash <%= is_alert ? "mensuration-flash--alert" : "mensuration-flash--success" %> mb-3" role="status">
            <i class="bi bi-<%= is_alert ? "exclamation-triangle" : "check-circle-fill" %> mensuration-flash__icon" aria-hidden="true"></i>
            <span><%= value %></span>
          </div>
        <% end %>

        <%= yield %>
      </main>

      <%= render "public/mensurations/footer" %>
    </div>
  </body>
</html>
