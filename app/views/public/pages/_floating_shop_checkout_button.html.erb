  
<div class="position-fixed bottom-0 start-0 end-0 bg-black p-2 shadow-lg public-floating-bar" 
     id="floating_shop_checkout_btn"
     style="z-index: 1050;">
  <div class="container-fluid">
    <div class="d-flex justify-content-center">
      <%= link_to cart_path,
          class: "btn btn-light btn-lg rounded-0 public-floating-bar__btn",
          data: { turbo_frame: "_top" } do %>
        <i class="bi bi-bag-check public-floating-bar__icon" aria-hidden="true"></i>
        <span class="public-floating-bar__label public-floating-bar__label--long"><%= t("public.pages.cart.floating_validate") %></span>
        <span class="public-floating-bar__label public-floating-bar__label--short"><%= t("public.pages.cart.floating_validate_short") %></span>
      <% end %>
    </div>
  </div>
</div>
