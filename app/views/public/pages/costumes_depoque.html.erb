<% content_for :structured_data do %>
  <script type="application/ld+json">
    <%= webpage_schema(
          name: meta_title,
          description: meta_description,
          url: public_page_url
        ).to_json.html_safe %>
  </script>
  <script type="application/ld+json">
    <%= breadcrumb_schema([
          { name: structured_breadcrumb_name(:home), url: structured_home_url },
          { name: t("public.pages.costumes_depoque.header_title"), url: public_page_url }
        ]).to_json.html_safe %>
  </script>
  <% faq_schema = seo_page_faq_schema(@page) %>
  <% if faq_schema.present? %>
    <script type="application/ld+json">
      <%= faq_schema.to_json.html_safe %>
    </script>
  <% end %>
<% end %>

<%= render "public/seo_pages/shared/hero",
           title: t("public.pages.costumes_depoque.header_title"),
           subtitle: t("public.pages.costumes_depoque.header_subtitle"),
           cta_url: produits_costumes_deguisements_path,
           cta_label: t("public.pages.costumes_depoque.hero_cta"),
           cta_type: "produits" %>

<div class="public-main-content">
  <%= render "public/seo_pages/shared/intro" %>

  <% if @apercu_costumes.any? %>
    <section class="container-fluid px-0 my-5 py-4">
      <div class="container">
        <div class="section-title-wrapper py-3 mb-3 text-center">
          <h2 class="text-light fs-3 text-uppercase section-title d-inline-block position-relative">
            <%= t("public.pages.costumes_depoque.preview_title") %>
            <span class="section-title-underline" style="background: white;"></span>
          </h2>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 justify-content-center">
          <% @apercu_costumes.each do |produit| %>
            <%= render partial: "public/pages/produit/produit", locals: { produit: produit } %>
          <% end %>
        </div>

        <div class="text-center mt-4">
          <%= link_to t("public.pages.costumes_depoque.hero_cta"),
                      produits_costumes_deguisements_path,
                      class: "btn btn-outline-light public-btn-border-radius" %>
        </div>
      </div>
    </section>
  <% end %>

  <% if @rubriques_costumes.any? %>
    <section class="container px-3 mb-5">
      <div class="d-flex flex-wrap gap-2 justify-content-center">
        <% @rubriques_costumes.each do |rubrique| %>
          <%= link_to rubrique.nom,
                      produits_costumes_deguisements_path(rubrique: rubrique.id),
                      class: "btn btn-outline-light public-btn-border-radius px-4" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= render "public/seo_pages/shared/sections" %>
  <%= render "public/seo_pages/shared/faq" %>
  <%= render "public/seo_pages/shared/related_pages" %>

  <div class="text-center my-5 py-4">
    <h2 class="mb-4 text-light h4"><%= t("public.pages.costumes_depoque.catalogue_heading") %></h2>
    <%= link_to t("public.pages.costumes_depoque.hero_cta"),
                produits_costumes_deguisements_path,
                class: "btn btn-light public-btn-border-radius" %>
  </div>
</div>
