<% content_for :structured_data do %>
  <script type="application/ld+json">
    <%= webpage_schema(
          name: meta_title,
          description: meta_description,
          url: public_page_url
        ).to_json.html_safe %>
  </script>
<% end %>

<%= page_header(
  t("public.pages.costumes_depoque.header_title"),
  t("public.pages.costumes_depoque.header_subtitle"),
  image1: "https://res.cloudinary.com/dukne3lhz/image/upload/q_auto,f_auto,w_1200/autres_activites1_n4ldap",
  image2: "https://res.cloudinary.com/dukne3lhz/image/upload/q_auto,f_auto,w_1200/autres_activites2_vhynvk"
) %>

<div class="public-main-content">
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8 text-light">
        <p class="lead"><%= t("public.pages.costumes_depoque.intro") %></p>
        <%= link_to produits_costumes_deguisements_path, class: "btn btn-light public-btn-border-radius mb-5" do %>
          <%= t("public.pages.costumes_depoque.collection_cta") %>
        <% end %>
      </div>
    </div>

    <% @rubriques_par_groupe.each do |groupe, rubriques| %>
      <h2 class="h4 text-light fw-bold mb-4"><%= groupe %></h2>
      <div class="d-flex flex-wrap gap-2 mb-5">
        <% rubriques.each do |rubrique| %>
          <%= link_to rubrique.nom,
                      produits_costumes_deguisements_path(rubrique: rubrique.id),
                      class: "btn btn-outline-light public-btn-border-radius" %>
        <% end %>
      </div>
    <% end %>

    <p class="text-light"><%= t("public.pages.nos_autres_activites.epoch_costumes.ideal_for") %></p>
  </div>

  <%= render "public/seo_pages/shared/related_pages" %>
</div>
