<% content_for :structured_data do %>
  <script type="application/ld+json">
    <%= webpage_schema(
          name: meta_title,
          description: meta_description,
          url: public_page_url
        ).to_json.html_safe %>
  </script>
<% end %>

<%= page_header(
    t("public.pages.rdv.header_title"),
    t("public.pages.rdv.header_subtitle"),
    image1: "https://res.cloudinary.com/dukne3lhz/image/upload/q_auto,f_auto,w_1200/rdv1_lzzo5t",
    image2: "https://res.cloudinary.com/dukne3lhz/image/upload/q_auto,f_auto,w_1200/rdv2_uoyzrm") %>



<div class="public-main-content">
  <%= render "public/shared/recaptcha_script" %>

  <%= render "public/shared/ticker_periode_speciale" %>

  <div class="container-fluid">
    <div class="row g-4 g-lg-5 my-4 my-lg-5 bg-white align-items-start">
      <!-- Process à gauche -->
      <div class="col-12 col-lg-5 col-xl-4 p-3 p-lg-4 mt-3 mt-lg-4" data-scroll-reveal>
        <div class="rdv-sidebar sticky-lg-top" style="top: 1.5rem;">
          <div class="d-flex flex-column gap-3 gap-lg-4">
            <div class="d-flex align-items-start gap-3">
              <div class="rdv-sidebar__icon flex-shrink-0">
                <i class="bi bi-calendar-check" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="h6 fw-bold mb-1 text-dark"><%= t("public.pages.rdv.steps.reservation.title") %></h2>
                <p class="text-dark opacity-75 small mb-0">
                  <%= t("public.pages.rdv.steps.reservation.description") %>
                </p>
              </div>
            </div>
            <div class="d-flex align-items-start gap-3">
              <div class="rdv-sidebar__icon flex-shrink-0">
                <i class="bi bi-bell" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="h6 fw-bold mb-1 text-dark"><%= t("public.pages.rdv.steps.confirmation.title") %></h2>
                <p class="text-dark opacity-75 small mb-0">
                  <%= t("public.pages.rdv.steps.confirmation.description") %>
                </p>
              </div>
            </div>
            <div class="d-flex align-items-start gap-3">
              <div class="rdv-sidebar__icon flex-shrink-0">
                <i class="bi bi-shop" aria-hidden="true"></i>
              </div>
              <div>
                <h2 class="h6 fw-bold mb-1 text-dark"><%= t("public.pages.rdv.steps.visit.title") %></h2>
                <p class="text-dark opacity-75 small mb-0">
                  <%= t("public.pages.rdv.steps.visit.description") %>
                </p>
              </div>
            </div>
          </div>

          <% cabine_count = @cabine_cart&.size.to_i %>
          <div class="rdv-cabine-callout mt-4 p-3 border border-dark-subtle">
            <% if cabine_count.positive? %>
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-door-open mt-1" aria-hidden="true"></i>
                <div>
                  <p class="fw-semibold small mb-1 text-dark">
                    <%= t("public.pages.rdv.cabine_callout.filled_title", count: cabine_count) %>
                  </p>
                  <p class="small text-dark opacity-75 mb-2">
                    <%= t("public.pages.rdv.cabine_callout.filled_body") %>
                  </p>
                  <%= link_to t("public.pages.rdv.cabine_callout.filled_cta"),
                              cabine_essayage_path,
                              class: "small fw-semibold text-dark" %>
                </div>
              </div>
            <% else %>
              <div class="d-flex align-items-start gap-2">
                <i class="bi bi-door-open mt-1" aria-hidden="true"></i>
                <div>
                  <p class="fw-semibold small mb-1 text-dark">
                    <%= t("public.pages.rdv.cabine_callout.empty_title") %>
                  </p>
                  <p class="small text-dark opacity-75 mb-2">
                    <%= t("public.pages.rdv.cabine_callout.empty_body") %>
                  </p>
                  <%= link_to t("public.pages.rdv.cabine_callout.empty_cta"),
                              cabine_essayage_path,
                              class: "btn btn-sm btn-dark rounded-0" %>
                </div>
              </div>
            <% end %>
          </div>

          <div class="mt-4">
            <%= render "public/shared/ticker_periode_speciale", variant: :light %>
          </div>
        </div>
      </div>

      <!-- Formulaire à droite -->
      <div class="col-12 col-lg-7 col-xl-8">
        <div id="rdv-form" class="p-2 p-lg-3 bg-white d-flex flex-column">
          <div style="position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column;">
            <%= render "public/demande_rdv/form", demande_rdv: @demande_rdv || DemandeRdv.new, from_cabine: false %>
          </div>
        </div>
      </div>
    </div>
  </div>
  
</div>
