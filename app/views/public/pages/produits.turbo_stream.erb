<%# produits infinite scroll pagination %>

<%= turbo_stream.append :produits do %>
    <%= render partial: "public/pages/produit/produit", 
            collection: @produits %>
<% end %>

<% if @pagy.next.present? %>
    <%= turbo_stream.replace :pagination do %>
        <%= turbo_frame_tag :pagination, loading: :lazy,
            data: { controller: "lazy-pagination" },
            src: produits_listing_page_path(format: :turbo_stream, page: @pagy.next) %>
    <% end %>
<% end %>
