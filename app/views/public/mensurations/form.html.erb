<% completed = @invitation.completed? %>
<% editing = @editing == true %>
<% choosing = params[:choose].present? || @invitation.template.blank? %>
<% thanks = completed && !editing && !choosing %>

<div class="mensuration-flow<%= " mensuration-flow--saved" if completed %>"
     <% unless thanks || choosing %>
     <% if @invitation&.template.present? %>
     data-controller="mensuration-step-url"
     data-mensuration-step-url-editing-value="<%= editing %>"
     data-action="turbo:submit-end@document->mensuration-step-url#syncAfterSubmit"
     <% end %>
     <% end %>>
  <div class="concept-card mensuration-form">
    <%= render "public/mensurations/card_header" %>

    <% if thanks %>
      <div class="mensuration-form__thanks" role="status">
        <i class="bi bi-check-circle-fill mensuration-form__thanks-icon" aria-hidden="true"></i>
        <p class="mensuration-form__thanks-title"><%= t("mensurations.form.thanks_title") %></p>
        <%= link_to t("mensurations.form.show_answers"),
              mensuration_path(token: @invitation.token, edit: 1, step: Mensuration::Flow::IDENTITY),
              class: "btn btn-sm btn-outline-light public-btn-border-radius mensuration-form__thanks-action" %>
        <%= button_to t("mensurations.form.delete"), mensuration_delete_path(token: @invitation.token), method: :delete,
              class: "mensuration-delete-link",
              form: {
                class: "mensuration-form__delete",
                onsubmit: "return confirm(#{t('mensurations.form.delete_confirm').to_json});"
              } %>
      </div>
    <% else %>
      <div class="mensuration-form__body">
        <% if choosing %>
          <%= render "public/mensurations/template_choice", invitation: @invitation %>
        <% else %>
          <div class="mensuration-form__stage mensuration-form__stage--wizard">
            <%= render "public/mensurations/progress_frame", flow: @flow, step: @step %>

            <%= render "public/mensurations/step_frame",
                  step: @step, mensuration: @mensuration, invitation: @invitation,
                  editing: editing, flow: @flow %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
