<%# locals: field, mensuration, guided %>
<% key = field["key"] %>
<% hint = t("mensurations.fields.#{key}.hint", default: "") %>
<% advice = t("mensurations.fields.#{key}.advice", default: "") %>
<% caption = "#{t("mensurations.fields.#{key}.short")}#{" *" if field["required"]}" %>
<div class="<%= guided ? "mensuration-guide__field" : (field["input"] == "textarea" ? "col-12" : "col-6") %>"
     <% if guided %>
       data-measure-guide-target="field"
       <% if field["clip"].present? %>data-clip="<%= field["clip"] %>"<% end %>
     <% end %>>
  <% case field["input"] %>
  <% when "choice" %>
    <%= mensuration_labeled_select "measurements[#{key}]",
          options_for_select(field["choices"].map { |c| [t("mensurations.choices.#{key}.#{c}"), c] }, mensuration.value_for(key)),
          caption,
          include_blank: true,
          title: hint.presence || t("mensurations.fields.#{key}.label") %>
  <% when "textarea" %>
    <%= mensuration_labeled_field "measurements[#{key}]", mensuration.value_for(key), caption,
          type: :textarea, title: hint.presence || t("mensurations.fields.#{key}.label") %>
  <% else %>
    <%= mensuration_labeled_field "measurements[#{key}]", mensuration.value_for(key), caption,
          required: field["required"],
          placeholder: (guided && field["clip"].present? ? t("mensurations.form.measure_placeholder") : hint.presence),
          title: hint.presence || t("mensurations.fields.#{key}.label"),
          layout: :group %>
  <% end %>
  <% if guided && advice.present? %>
    <%= render "public/mensurations/advice", text: advice, extra_class: "mensuration-guide__field-advice" %>
  <% end %>
</div>
