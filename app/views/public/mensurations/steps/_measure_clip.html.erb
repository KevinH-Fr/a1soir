<%# locals: step, mensuration, invitation, editing %>
<% field = step.fields.first %>
<% key = field["key"] %>
<% hint = t("mensurations.fields.#{key}.hint", default: "") %>
<% advice = t("mensurations.fields.#{key}.advice", default: "") %>
<% name = mensuration_field_caption(key) %>
<% ruler = mensuration_field_ruler(key) %>

<%= form_with url: mensuration_step_path(token: invitation.token), method: :patch do %>
  <%= hidden_field_tag :step, step.key %>

  <div class="mensuration-form__step-content">
    <h2 class="h6 mb-2 text-light"><%= t(step.title_key) %></h2>
    <% step_hint = step.hint_key && t(step.hint_key, default: "") %>
    <% if step_hint.present? %>
      <%= render "public/mensurations/advice", text: step_hint, extra_class: "mb-3 mensuration-form__advice--quiet" %>
    <% end %>

    <% if mensuration.errors.any? %>
      <div class="alert alert-danger py-2 small" role="alert">
        <%= mensuration.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="mensuration-guide mensuration-guide--howto"
       data-controller="figure-ruler"
       data-figure-ruler-clip-value="<%= field["clip"] %>"
       data-figure-ruler-label-value="<%= ruler %>">
      <div class="mensuration-guide__figure">
        <div class="mensuration-guide__caption">
          <h2 class="mensuration-guide__title"><%= name %></h2>
          <% if advice.present? %>
            <p class="mensuration-guide__howto"><%= advice %></p>
          <% end %>
        </div>
        <div class="mensuration-guide__figure-stage">
          <%= render "public/mensurations/figure_svg" %>
        </div>
        <div class="mensuration-guide__fields">
          <div class="mensuration-guide__field">
            <%= mensuration_labeled_field "measurements[#{key}]", mensuration.value_for(key), name,
                  required: field["required"],
                  placeholder: mensuration_field_example(key),
                  title: hint.presence || t("mensurations.fields.#{key}.label"),
                  layout: :group,
                  class: "mensuration-guide__value",
                  addon: t("mensurations.form.measure_placeholder"),
                  "aria-label" => name,
                  data: { figure_ruler_target: "input", action: "input->figure-ruler#input" } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render "public/mensurations/steps/nav", step: step, mensuration: mensuration,
        invitation: invitation, editing: editing %>
<% end %>
