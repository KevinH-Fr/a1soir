<% code_pending = @invitation.otp_sent_at.present? && @invitation.otp_sent_at > MensurationInvitation::OTP_VALIDITY.ago %>

<div class="mensuration-otp">
  <%= render "public/mensurations/card_header" %>
  <p class="mensuration-otp__hint">
    <% if code_pending %>
      <%= t("mensurations.otp.enter_hint", email: @invitation.email) %>
    <% else %>
      <%= t("mensurations.otp.request_hint") %>
    <% end %>
  </p>

  <% if code_pending %>
    <%= form_with url: mensuration_verify_path(token: @invitation.token), method: :post, local: true,
          html: {
            class: "mensuration-otp__actions",
            data: {
              controller: "otp-submit",
              otp_submit_length_value: 6,
              action: "submit->otp-submit#prepareSubmit"
            }
          } do |f| %>
      <%= f.hidden_field :code, value: "", data: { otp_submit_target: "hidden" }, autocomplete: "off" %>
      <div class="mensuration-otp__digits" role="group" aria-label="<%= t("mensurations.otp.code_label") %>">
        <% 6.times do |i| %>
          <input type="text"
                 class="mensuration-otp__digit"
                 inputmode="numeric"
                 pattern="[0-9]*"
                 maxlength="1"
                 autocomplete="<%= i.zero? ? "one-time-code" : "off" %>"
                 aria-label="<%= t("mensurations.otp.digit_label", position: i + 1, length: 6) %>"
                 data-otp-submit-target="digit"
                 data-action="input->otp-submit#input keydown->otp-submit#keydown paste->otp-submit#paste"
                 <%= "autofocus" if i.zero? %>>
        <% end %>
      </div>
      <%= f.submit t("mensurations.otp.verify"), class: "btn btn-light public-btn-border-radius w-100 py-2" %>
    <% end %>

    <div class="mensuration-otp__resend">
      <%= button_to t("mensurations.otp.resend_code"), mensuration_otp_path(token: @invitation.token),
            method: :post,
            class: "btn btn-link btn-sm text-light opacity-50 p-0" %>
      <p class="mensuration-otp__spam-hint"><%= t("mensurations.otp.spam_hint") %></p>
    </div>
  <% else %>
    <div class="mensuration-otp__actions">
      <%= button_to t("mensurations.otp.send_code"), mensuration_otp_path(token: @invitation.token),
            method: :post,
            class: "btn btn-light public-btn-border-radius w-100 py-2",
            form_class: "d-block" %>
    </div>
  <% end %>

  <p class="mensuration-otp__resume-hint">
    <%= t("mensurations.otp.resume_hint") %>
  </p>
</div>
