<% code_pending = @invitation.otp_sent_at.present? && @invitation.otp_sent_at > MensurationInvitation::OTP_VALIDITY.ago %>
<% field_class = "form-control bg-dark text-light border-secondary text-center" %>

<div class="concept-card mensuration-otp">
  <h1 class="h5 mb-0 text-light"><%= t("mensurations.otp.request_title") %></h1>
  <p class="text-light opacity-75 small my-4 mensuration-otp__hint">
    <%= t("mensurations.otp.request_hint") %>
  </p>

  <% if code_pending %>
    <%= form_with url: mensuration_verify_path(token: @invitation.token), method: :post, local: true, html: { class: "mensuration-otp__actions" } do |f| %>
      <div class="mb-3">
        <%= f.text_field :code,
              class: field_class,
              inputmode: "numeric",
              autocomplete: "one-time-code",
              maxlength: 6,
              required: true,
              autofocus: true,
              placeholder: t("mensurations.otp.code_label"),
              "aria-label": t("mensurations.otp.code_label"),
              data: { controller: "otp-submit", action: "input->otp-submit#check" } %>
      </div>
      <%= f.submit t("mensurations.otp.verify"), class: "btn btn-light public-btn-border-radius w-100 py-2" %>
    <% end %>

    <div class="mt-4">
      <%= button_to t("mensurations.otp.resend_code"), mensuration_otp_path(token: @invitation.token),
            method: :post,
            class: "btn btn-link btn-sm text-light opacity-50 p-0" %>
    </div>
  <% else %>
    <div class="mensuration-otp__actions">
      <%= button_to t("mensurations.otp.send_code"), mensuration_otp_path(token: @invitation.token),
            method: :post,
            class: "btn btn-light public-btn-border-radius w-100 py-2",
            form_class: "d-block" %>
    </div>
  <% end %>
</div>
