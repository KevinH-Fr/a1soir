<div class="card">
  <div class="card-body p-4">
    <h1 class="h4 mb-3"><%= t("mensurations.otp.request_title") %></h1>
    <p class="text-muted"><%= t("mensurations.otp.request_hint") %></p>

    <% code_pending = @invitation.otp_sent_at.present? && @invitation.otp_sent_at > MensurationInvitation::OTP_VALIDITY.ago %>

    <% if code_pending %>
      <%= form_with url: mensuration_verify_path(token: @invitation.token), method: :post, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :code, t("mensurations.otp.code_label"), class: "form-label" %>
          <%= f.text_field :code, class: "form-control", inputmode: "numeric", autocomplete: "one-time-code", maxlength: 6, required: true, autofocus: true %>
        </div>
        <%= f.submit t("mensurations.otp.verify"), class: "btn btn-dark" %>
      <% end %>

      <div class="mt-3">
        <%= button_to t("mensurations.otp.resend_code"), mensuration_otp_path(token: @invitation.token), method: :post, class: "btn btn-link btn-sm p-0" %>
      </div>
    <% else %>
      <%= button_to t("mensurations.otp.send_code"), mensuration_otp_path(token: @invitation.token), method: :post, class: "btn btn-dark" %>
    <% end %>
  </div>
</div>
