<div id="<%= dom_id meeting %>">

  <div class="card mx-2 light-beige-colored shadow-sm">
    <div class="card-body p-2">
      <div class="row text-start align-items-center g-2">
        <div class="col">
          <%= custom_badge("", "", "", "", meeting.nom) %>
          <%= custom_badge("fa-calendar", "", "", "", meeting.full_date) %>

          <% if meeting.lieu.present? %>
            <%= custom_badge("fa-map", "", "", "", meeting.lieu) %>
          <% end %>

          <% if meeting.commande %>
            <% unless controller_name == "commandes" && action_name == "show" %>
              <%= link_to admin_commande_path(meeting.commande),
                          class: "text-decoration-none text-dark",
                          data: { turbo: false } do %>
                <%= custom_badge("", "", "", "", meeting.commande.full_name) %>
              <% end %>
            <% end %>
          <% end %>

          <% client = meeting.client || meeting.commande&.client %>
          <% if client %>
            <% unless controller_name == "clients" && action_name == "show" %>
              <%= link_to admin_client_path(client),
                          class: "text-decoration-none text-dark",
                          data: { turbo: false } do %>
                <%= custom_badge("", "", "", "", client.full_name) %>
              <% end %>
            <% end %>
          <% end %>
        </div>
        <div class="col-auto ms-auto">
          <%= links_record(meeting) %>
        </div>
      </div>

      <% produits_cabine = meeting.produits_cabine %>
      <% if produits_cabine&.any? %>
        <% cabine_collapse_id = "collapseCabine#{dom_id(meeting)}" %>
        <div class="mt-1">
          <a class="small text-muted text-decoration-none d-inline-flex align-items-center ms-1"
             data-bs-toggle="collapse"
             href="#<%= cabine_collapse_id %>"
             role="button"
             aria-expanded="false"
             aria-controls="<%= cabine_collapse_id %>">
            <%= admin_collapse_details_button_content(label: "Articles") %>
          </a>
        </div>
        <div class="collapse" id="<%= cabine_collapse_id %>">
          <div class="pt-2 px-2">
            <%= render "admin/demande_cabine_essayages/produits", produits: produits_cabine %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

</div>
