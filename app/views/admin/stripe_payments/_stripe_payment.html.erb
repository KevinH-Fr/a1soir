<% p = stripe_payment %>
<% c = p.commande %>
<tr class="border-bottom border-secondary-subtle">
  <td class="py-2 py-md-3 px-2 px-md-3 text-nowrap small"><%= l(p.created_at, format: :short) %></td>
  <td class="py-2 py-md-3 px-2 px-md-3 text-end text-nowrap fw-semibold"><%= stripe_payment_amount(p) %></td>
  <td class="py-2 py-md-3 px-2 px-md-3">
    <span class="badge rounded-pill px-2 px-md-3 py-1 py-md-2 fw-normal <%= stripe_payment_status_klass(p) %>">
      <%= p.status %>
    </span>
  </td>
  <td class="py-2 py-md-3 px-2 px-md-3 small text-break">
    <%= p.customer_email.presence || content_tag(:span, "—", class: "text-muted") %>
  </td>
  <td class="py-2 py-md-3 px-2 px-md-3"><%= stripe_payment_expedition_badge(c) %></td>
  <td class="py-2 py-md-3 px-2 px-md-3"><%= stripe_payment_commande_link(c) %></td>
</tr>
