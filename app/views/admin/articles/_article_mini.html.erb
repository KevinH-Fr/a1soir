<div class="card mx-2 my-3 p-2 light-beige-colored shadow-sm">
    <div class="row d-flex align-items-center">
        <div class="col-2 text-center">
          <%= cloudinary_attachment_image(article.produit.default_image, width: 100, html_width: 50, alt: article.produit.nom, class: "rounded") %>  
        </div>
        <div class="col ps-4">
            <h4 class="fw-bold"> <%= article.produit.nom %>  </h4>
            <%= article.locvente %>  
            qté.: <%= article.quantite %>  
            prix: <%= article.prix %>  
            total: <%= article.total %>  
            caution: <%= article.caution %>           
       </div>
    </div>
</div>
