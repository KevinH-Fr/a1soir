<%= bandeau_entete("Commandes", 'file-earmark-fill', @count_commandes,
  :nom_or_type_locvente_or_typeevent_or_ref_commande_or_client_nom_or_client_prenom_or_profile_nom_or_profile_prenom_cont, admin_commandes_path) do %>
  <%= button_to create_commande_rapide_admin_commandes_path,
        method: :post,
        class: "btn btn-sm btn-outline-warning d-inline-flex align-items-center gap-1 ms-1",
        title: "Commande rapide",
        aria: { label: "Commande rapide" } do %>
    <i class="bi bi-lightning-charge-fill" aria-hidden="true"></i>
    <span class="d-none d-md-inline">Rapide</span>
  <% end %>
<% end %>

<%= bloc_nouveau(Commande) %>

<%= turbo_frame_tag :results, data: {turbo_action: 'advance'} do %>
  <div id="commandes" class="<%= admin_list_stack_classes %>"> </div> 

  <%= turbo_frame_tag :pagination, loading: :lazy, 
                        src: admin_commandes_path(format: :turbo_stream,
                        q: params[:q]&.to_unsafe_h) %>
<% end %>
