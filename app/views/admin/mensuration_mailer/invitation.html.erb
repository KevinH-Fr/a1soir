<!DOCTYPE html>
<html>
  <body>
    <p>
      <% if @invitation.full_name.present? %>
        <%= I18n.t('mensurations.mailer.invitation.greeting', name: @invitation.full_name) %>
      <% else %>
        <%= I18n.t('mensurations.mailer.invitation.greeting_no_name') %>
      <% end %>
    </p>

    <p><%= I18n.t('mensurations.mailer.invitation.body') %></p>

    <% if @invitation.message_perso.present? %>
      <p style="border-left: 3px solid #ccc; padding-left: 12px; color: #444;">
        <%= simple_format(@invitation.message_perso) %>
      </p>
    <% end %>

    <p style="margin: 24px 0;">
      <a href="<%= @url %>" style="background-color: #111; color: #fff; padding: 12px 24px; text-decoration: none; border-radius: 4px; display: inline-block;">
        <%= I18n.t('mensurations.mailer.invitation.cta') %>
      </a>
    </p>

    <p style="font-size: 13px; color: #666;">
      <%= I18n.t('mensurations.mailer.invitation.validity', date: I18n.l(@invitation.expires_at.to_date)) %>
    </p>

    <p><%= I18n.t('mensurations.mailer.invitation.signature') %></p>
  </body>
</html>
