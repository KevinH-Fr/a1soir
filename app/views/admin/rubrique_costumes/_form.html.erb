<% rubrique_compact_collapse = local_assigns[:index_collapse] && !rubrique_costume.persisted? %>
<%= render layout: "admin/shared/form_card_shell",
           locals: {
             compact: rubrique_compact_collapse,
             embedded: local_assigns.fetch(:admin_form_row_embedded, false)
           } do %>
  <%= form_with(model: rubrique_costume, url: rubrique_costume.persisted? ? admin_rubrique_costume_path(rubrique_costume) : admin_rubrique_costumes_path, method: rubrique_costume.persisted? ? :patch : :post, data: { turbo: true }) do |form| %>
    <% if rubrique_costume.errors.any? %>
      <div style="color: red">
        <h2><%= admin_save_error_title(rubrique_costume) %></h2>
        <ul>
          <% rubrique_costume.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="input-group mb-1">
      <%= form.label :nom, "Nom", class: "input-group-text" %>
      <%= form.text_field :nom, class: "form-control" %>
    </div>
    <div class="input-group mb-1">
      <%= form.label :groupe, "Groupe", class: "input-group-text" %>
      <%= form.text_field :groupe, class: "form-control", list: "rubrique-costume-groupes" %>
      <datalist id="rubrique-costume-groupes">
        <% RubriqueCostume.distinct.order(:groupe).pluck(:groupe).each do |groupe| %>
          <option value="<%= groupe %>"></option>
        <% end %>
      </datalist>
    </div>
    <div class="input-group mb-1">
      <%= form.label :position, "Position", class: "input-group-text" %>
      <%= form.number_field :position, class: "form-control" %>
    </div>

    <%= custom_submit_button(form) %>
  <% end %>
<% end %>
