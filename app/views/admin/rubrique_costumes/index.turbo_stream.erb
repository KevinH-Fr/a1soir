<%= turbo_stream.append :rubrique_costumes do %>
  <%= render partial: "admin/rubrique_costumes/rubrique_costume", collection: @rubrique_costumes, as: :rubrique_costume %>
<% end %>

<% if @pagy.next.present? %>
  <%= turbo_stream.replace :pagination do %>
    <%= turbo_frame_tag :pagination, loading: :lazy,
                        src: admin_rubrique_costumes_path(format: :turbo_stream,
                        page: @pagy.next, q: params[:q]&.to_unsafe_h) %>
  <% end %>
<% end %>
