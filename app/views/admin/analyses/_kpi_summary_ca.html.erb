<% ca_hint = capture do %>
  <% if analyses_ca_mode_lignes? %>
    Montants des articles
  <% else %>
    Boutique <%= analyses_donut_amount_label(@totalPrixCaBoutique) %> €
    <span class="mx-1">·</span>
    Stripe <%= analyses_donut_amount_label(@totalPrixCaStripe) %> €
  <% end %>
<% end %>

<div class="row row-cols-2 row-cols-lg-4 g-2 g-sm-3">
  <%= render "kpi_card",
        title: "CA TTC",
        value: "#{analyses_donut_amount_label(@totalPrixCa)} €",
        badge: (analyses_ca_mode_lignes? ? "articles" : nil),
        trend_metric: :ca,
        hint: ca_hint,
        hint_class: (analyses_ca_mode_lignes? ? nil : "lh-sm") %>

  <%= render "kpi_card",
        title: "Transactions TTC",
        value: "#{analyses_donut_amount_label(@totalTransactions)} €",
        trend_metric: :transactions,
        hint: "Loc #{analyses_donut_amount_label(@totalTransactionsLoc)} € · Vente #{analyses_donut_amount_label(@totalTransactionsVente)} €" %>

  <%= render "kpi_card",
        title: "Commandes",
        value: @nbTotal,
        trend_metric: :commandes,
        hint: (analyses_ca_panier_moyen ? "Panier moy. #{analyses_donut_amount_label(analyses_ca_panier_moyen)} €" : nil) %>

  <%= render "kpi_card",
        title: "Stripe",
        value: "#{analyses_donut_amount_label(@totalPrixCaStripe)} €",
        trend_metric: :stripe,
        hint: "E-shop (net remboursements)" %>
</div>
