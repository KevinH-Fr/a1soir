<% ca_hints = analyses_ca_channel_hints %>
<% panier = analyses_ca_panier_moyen %>
<% art_par_cmd = analyses_articles_par_commande %>
<% remb = analyses_remboursements_eshop %>
<% eshop = analyses_eshop_counts %>

<div class="row row-cols-1 row-cols-lg-4 g-2 g-sm-3">
  <%= render "kpi_card",
        title: "CA TTC",
        value: "#{analyses_donut_amount_label(@totalPrixCa)} €",
        badge: (analyses_ca_mode_lignes? ? "articles" : nil),
        trend_metric: :ca,
        hint: ca_hints[:hint],
        hint2: ca_hints[:hint2] %>

  <%= render "kpi_card",
        title: "Transactions TTC",
        value: "#{analyses_donut_amount_label(@totalTransactions)} €",
        trend_metric: :transactions,
        hint: "Location #{analyses_donut_amount_label(@totalTransactionsLoc)} €",
        hint2: "Vente #{analyses_donut_amount_label(@totalTransactionsVente)} €" %>

  <%= render "kpi_card",
        title: "Commandes",
        value: @nbTotal,
        trend_metric: :commandes,
        hint: (panier ? "Panier moyen #{analyses_donut_amount_label(panier)} €" : nil),
        hint2: [
          (art_par_cmd ? "#{art_par_cmd} articles / commande" : nil),
          ("#{@nbDevisPeriode} devis" if @nbDevisPeriode.to_i.positive?)
        ].compact.join(" · ").presence %>

  <%= render "kpi_card",
        title: "E-shop",
        value: "#{analyses_donut_amount_label(@totalPrixCaStripe)} €",
        trend_metric: :stripe,
        hint: "#{eshop[:commandes]} commandes · #{eshop[:articles]} articles",
        hint2: (remb.positive? ? "Remb. #{analyses_donut_amount_label(remb)} €" : "Sans remboursement") %>
</div>
