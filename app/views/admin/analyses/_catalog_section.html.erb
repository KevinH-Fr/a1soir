<% show_type = analyses_visibility_show?(:catalog_by_type) %>
<% show_cat = analyses_visibility_show?(:catalog_by_categorie) %>
<% show_locvente = analyses_visibility_show?(:articles_locvente_split) %>
<% chart_count = [show_locvente, show_type, show_cat].count(true) %>
<% chart_col = case chart_count
               when 1 then "col-12"
               when 2 then "col-lg-6"
               else "col-lg-4"
               end %>
<% type_count = [(@catalog_by_type || []).size, (@catalog_by_type_by_ca || []).size, 3].max %>
<% cat_count = [(@catalog_by_categorie || []).size, (@catalog_by_categorie_by_ca || []).size, 3].max %>
<% bars_h = analyses_equipe_bars_height_rem([type_count, cat_count].max) %>

<div class="analyses-chart-stack">
  <% if chart_count.positive? %>
    <div class="<%= AnalysesHelper::ANALYSES_CONTENT_ROW %>">
      <% if show_locvente %>
        <div class="<%= chart_col %> min-w-0">
          <%= analyses_chart_card(extra_class: "analyses-chart-card--flush-center") do %>
            <%= render "admin/analyses/locvente_metric_doughnut",
                  euro_key: :articles_locvente_ca_doughnut,
                  euro_aria: "Répartition location et vente du CA articles",
                  chart_id: "analyses-chart-locvente-catalogue" %>
          <% end %>
        </div>
      <% end %>
      <% if show_cat %>
        <div class="<%= chart_col %> min-w-0" data-controller="analyses-segment-toggle" data-analyses-segment-toggle-active-value="qty">
          <%= analyses_chart_card do %>
            <%= analyses_chart_heading_with_toggle("Par catégorie", meta: "Top 5") %>
            <%= render_analyses_toggleable_chart(
                  :catalog_categories_bars,
                  :catalog_categories_bars_ca,
                  chart_id: "analyses-chart-catalog-categories",
                  extra_class: "analyses-chart--fill analyses-chart--catalog-bars",
                  box_style: "--analyses-chart-height: #{bars_h}rem",
                  aria_label: "Répartition par catégorie"
                ) %>
          <% end %>
        </div>
      <% end %>
      <% if show_type %>
        <div class="<%= chart_col %> min-w-0" data-controller="analyses-segment-toggle" data-analyses-segment-toggle-active-value="qty">
          <%= analyses_chart_card do %>
            <%= analyses_chart_heading_with_toggle("Par type", meta: "Top 5") %>
            <%= render_analyses_toggleable_chart(
                  :catalog_types_bars,
                  :catalog_types_bars_ca,
                  chart_id: "analyses-chart-catalog-types",
                  extra_class: "analyses-chart--fill analyses-chart--catalog-bars",
                  box_style: "--analyses-chart-height: #{bars_h}rem",
                  aria_label: "Répartition par type de produit"
                ) %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= analyses_full_bleed_chart(
        data: {
          controller: "analyses-segment-toggle",
          analyses_segment_toggle_active_value: "qty"
        }
      ) do %>
    <%= analyses_chart_card do %>
      <%= analyses_chart_heading_with_toggle(
            "Produits les plus demandés",
            meta: "Top #{Analyses::CatalogStats::TOP_LIMIT} · quantités et montants des lignes"
          ) %>
      <%= render "catalog_top_products" %>
    <% end %>
  <% end %>
</div>
