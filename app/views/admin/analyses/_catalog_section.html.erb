<%= render_dashboard_section("Catalogue", "bi bi-bag", []) do %>
  <% show_type = analyses_visibility_show?(:catalog_by_type) %>
  <% show_cat = analyses_visibility_show?(:catalog_by_categorie) %>

  <%= render "catalog_top_products" %>

  <% if show_type || show_cat %>
    <div class="row g-3 mt-1">
      <% if show_type %>
        <div class="<%= show_cat ? "col-lg-6" : "col-12" %>">
          <p class="small text-body-secondary mb-2">Quantités par type</p>
          <%= render_analyses_chart(:catalog_types_horizontal, aria_label: "Quantités par type de produit") %>
        </div>
      <% end %>
      <% if show_cat %>
        <div class="<%= show_type ? "col-lg-6" : "col-12" %>">
          <p class="small text-body-secondary mb-2">Quantités par catégorie</p>
          <%= render_analyses_chart(:catalog_categories_horizontal, aria_label: "Quantités par catégorie") %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
