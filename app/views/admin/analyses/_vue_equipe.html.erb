<% if analyses_visibility_show?(:kpi) %>
  <%= render_analyses_kpi_section %>
<% end %>

<% if analyses_visibility_show?(:profiles_section) %>
  <% header_notice = analyses_visibility_show?(:profiles_comparison) ? nil : "Un seul vendeur sélectionné — comparaison multi-vendeurs masquée." %>
  <% show_comparison = analyses_visibility_show?(:profiles_comparison) %>
  <% show_timeline = (@stats_par_profile || []).any? { |r| r[:ca_by_day].present? } %>
  <% show_devis_chart = (@stats_par_profile || []).any? { |r| r[:devis_cohorte].to_i.positive? } %>

  <% if header_notice.present? %>
    <%= analyses_info_alert(header_notice, extra_class: "mb-3") %>
  <% end %>

  <div class="analyses-chart-stack mt-3">
    <div class="<%= AnalysesHelper::ANALYSES_CONTENT_ROW %>">
      <div class="col-12 col-lg-4 min-w-0">
        <%= analyses_chart_card(extra_class: "analyses-chart-card--flush-center") do %>
          <%= analyses_chart_heading(show_comparison ? "CA par vendeur" : "CA vendeur") %>
          <div class="d-flex justify-content-center flex-grow-1 align-items-center">
            <%= render_analyses_chart(
                  :profiles_ca_doughnut,
                  chart_id: "analyses-chart-profiles-ca-doughnut",
                  extra_class: "analyses-chart--compact",
                  aria_label: show_comparison ? "Répartition du CA par vendeur" : "CA du vendeur"
                ) %>
          </div>
        <% end %>
      </div>
      <div class="col-12 col-lg-8 min-w-0">
        <%= analyses_chart_card(extra_class: "analyses-chart-card--equipe-ranking") do %>
          <%= analyses_chart_heading("Classement vendeurs") %>
          <%= render "equipe_ranking_table" %>
        <% end %>
      </div>
    </div>

    <% if show_timeline || show_devis_chart %>
      <div class="<%= AnalysesHelper::ANALYSES_CONTENT_ROW %>">
        <% if show_timeline %>
          <div class="<%= show_devis_chart ? "col-12 col-lg-8" : "col-12" %> min-w-0">
            <%= analyses_chart_card do %>
              <%= analyses_chart_heading(
                    show_comparison ? "Évolution du CA par vendeur" : "Évolution du CA"
                  ) %>
              <%= render_analyses_chart(
                    :profiles_ca_timeline,
                    chart_id: "analyses-chart-profiles-timeline",
                    extra_class: "analyses-chart--fill analyses-chart--equipe-timeline",
                    aria_label: show_comparison ? "Évolution du CA par vendeur" : "Évolution du CA du vendeur"
                  ) %>
            <% end %>
          </div>
        <% end %>
        <% if show_devis_chart %>
          <div class="<%= show_timeline ? "col-12 col-lg-4" : "col-12" %> min-w-0">
            <%= analyses_chart_card do %>
              <% devis_totals = analyses_equipe_kpi_totals %>
              <%= analyses_chart_heading(
                    "Transformation des devis",
                    meta: analyses_devis_transformes_phrase(
                      devis_totals[:devis_transformes],
                      taux: devis_totals[:taux_transformation_devis]
                    )
                  ) %>
              <%= render_analyses_chart(
                    :profiles_devis_transformation,
                    chart_id: "analyses-chart-equipe-devis",
                    extra_class: "analyses-chart--fill analyses-chart--equipe-timeline",
                    aria_label: "Devis encore ouverts ou transformés"
                  ) %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
