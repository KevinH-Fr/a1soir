<div id="analyses_filters_inner" class="d-flex flex-column flex-grow-1 min-h-0">
  <div class="offcanvas-body analyses-filters-panel__body flex-grow-1 overflow-auto d-flex flex-column gap-0 pb-0">
    <section class="analyses-filters-panel__section" aria-labelledby="analysesFiltersContextHeading">
      <h3 class="analyses-filters-panel__section-title" id="analysesFiltersContextHeading">
        Contexte
      </h3>
      <div class="d-flex flex-column gap-3">
        <% if analyses_visibility_show?(:filter_profile_dropdown) %>
          <div class="w-100 analyses-filter-field">
            <%= analyses_filter_dropdown(
                  label: "Profil",
                  icon: "bi bi-person",
                  param_key: :filter_profile,
                  collection: @profiles_for_filter,
                  model: Profile,
                  all_label: "Tous les profils"
                ) %>
          </div>
        <% end %>

        <div class="analyses-filters-panel__field">
          <p class="analyses-filters-panel__field-label">Canal</p>
          <%= analyses_filter_toggle_group(
                aria_label: "Canal boutique ou e-shop",
                param_key: :filter_eshop,
                options: [["Tous", nil], ["Boutique", "false"], ["E-shop", "true"]]
              ) %>
        </div>

        <div class="analyses-filters-panel__field">
          <p class="analyses-filters-panel__field-label">Location / vente</p>
          <%= analyses_filter_toggle_group(
                aria_label: "Location ou vente",
                param_key: :filter_locvente,
                options: [["Tous", nil], ["Location", "location"], ["Vente", "vente"]]
              ) %>
        </div>
      </div>
    </section>

    <section class="analyses-filters-panel__section" aria-labelledby="analysesFiltersCatalogHeading">
      <h3 class="analyses-filters-panel__section-title" id="analysesFiltersCatalogHeading">
        Catalogue
      </h3>
      <div class="d-flex flex-column gap-2">
        <div class="analyses-filter-field">
          <%= analyses_filter_dropdown(
                label: "Type",
                icon: "bi bi-tag",
                param_key: :filter_type_produit,
                collection: @type_produits,
                model: TypeProduit,
                all_label: "Tous les types"
              ) %>
        </div>
        <div class="analyses-filter-field">
          <%= analyses_filter_dropdown(
                label: "Catégorie",
                icon: "bi bi-layers",
                param_key: :filter_categorie,
                collection: @categorie_produits,
                model: CategorieProduit,
                all_label: "Toutes les catégories"
              ) %>
        </div>
        <div class="analyses-filter-field">
          <%= analyses_filter_dropdown(
                label: "Taille",
                icon: "bi bi-rulers",
                param_key: :filter_taille,
                collection: @tailles,
                model: Taille,
                all_label: "Toutes les tailles"
              ) %>
        </div>
        <div class="analyses-filter-field">
          <%= analyses_filter_dropdown(
                label: "Couleur",
                icon: "bi bi-palette",
                param_key: :filter_couleur,
                collection: @couleurs,
                model: Couleur,
                all_label: "Toutes les couleurs"
              ) %>
        </div>
      </div>
    </section>
  </div>

  <div class="analyses-filters-panel__footer mt-auto">
    <% if analyses_active_filters_count.positive? %>
      <%= link_to "Effacer tout",
                  analyses_clear_filters_path,
                  class: "analyses-filters-panel__clear",
                  data: { turbo_stream: true } %>
    <% end %>
    <button type="button"
            class="analyses-filters-panel__done ms-auto"
            data-bs-dismiss="offcanvas">
      Terminé
    </button>
  </div>
</div>
