<div class="col">
  <div class="analyses-kpi h-100">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
      <span class="analyses-kpi__title text-truncate"><%= title %></span>
      <% if local_assigns[:badge].present? %>
        <span class="badge rounded-pill text-bg-light border text-body-secondary fw-normal"><%= badge %></span>
      <% end %>
    </div>

    <div class="analyses-kpi__value-row">
      <div class="analyses-kpi__value text-truncate" title="<%= value %>"><%= value %></div>
      <% if local_assigns[:trend_metric].present? %>
        <%= render_analyses_kpi_trend(trend_metric) %>
      <% end %>
    </div>

    <% if local_assigns[:hint].present? %>
      <div class="<%= class_names("analyses-kpi__hint", local_assigns[:hint_class]) %>"><%= hint %></div>
    <% end %>
  </div>
</div>
