<% top = @catalog_top_products&.first %>
<div class="row row-cols-2 row-cols-lg-4 g-2 g-sm-3">
  <%= render "kpi_card",
        title: "Quantités",
        value: analyses_catalog_kpi_quantite,
        trend_metric: :quantites,
        hint: "#{@nbTotalArticles} articles" %>

  <%= render "kpi_card",
        title: "CA lignes",
        value: "#{analyses_donut_amount_label(analyses_catalog_kpi_ca_lignes)} €",
        trend_metric: :ca_lignes,
        hint: "Montants des lignes sur la période" %>

  <%= render "kpi_card",
        title: "Produits",
        value: analyses_catalog_kpi_produits_count,
        trend_metric: :produits,
        hint: "Références distinctes" %>

  <%= render "kpi_card",
        title: "Top produit",
        value: (top ? top[:quantite] : "—"),
        hint: (top ? analyses_catalog_top_product_label : "Aucune ligne") %>
</div>
