<%# locals: chart_id, qty_config, ca_config, qty_center:, ca_center:, extra_class: nil, box_style: nil, aria_label: nil %>
<% qty_center = local_assigns.fetch(:qty_center, []) %>
<% ca_center = local_assigns.fetch(:ca_center, []) %>
<div class="<%= analyses_chart_box_classes(extra_class) %>"<% if local_assigns[:box_style].present? %> style="<%= box_style %>"<% end %>>
  <div class="analyses-chart-plot">
    <canvas
      id="<%= chart_id %>"
      data-analyses-chart="<%= qty_config.to_json %>"
      data-analyses-segment-toggle-target="canvas"
      data-chart-qty="<%= qty_config.to_json %>"
      data-chart-ca="<%= ca_config.to_json %>"
      data-center-qty="<%= qty_center.to_json %>"
      data-center-ca="<%= ca_center.to_json %>"
      role="img"
      aria-label="<%= local_assigns[:aria_label] || "Graphique" %>"
    ></canvas>
    <% if qty_center.present? %>
      <div class="analyses-donut-center" data-analyses-segment-toggle-target="center" aria-hidden="true">
        <% qty_center.each_with_index do |line, index| %>
          <span class="analyses-donut-center__line analyses-donut-center__line--<%= index %>"><%= line %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
