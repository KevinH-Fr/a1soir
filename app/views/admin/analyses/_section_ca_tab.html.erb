<% if analyses_visibility_show?(:ca_section) %>
  <% ca_notice = analyses_ca_mode_lignes? ? "CA basé sur les montants des lignes articles (filtre produit actif), pas sur les encaissements CB/espèces." : nil %>
  <% show_tx_doughnut = analyses_visibility_show?(:transactions_section) %>
  <%= render_dashboard_section("Chiffre d'affaires", "bi bi-cash", [], header_notice: ca_notice) do %>
    <div class="row g-3 align-items-stretch">
      <% if analyses_visibility_show?(:ca_pie_payment_modes) %>
        <div class="col-lg-5">
          <p class="small text-body-secondary mb-2">Répartition par mode de paiement</p>
          <div class="d-flex justify-content-center">
            <%= render_analyses_chart(:ca_payment_modes_doughnut, extra_class: "analyses-chart--compact", aria_label: "Répartition du CA par mode de paiement") %>
          </div>
        </div>
        <div class="col-lg-7">
          <p class="small text-body-secondary mb-2">Évolution CA &amp; transactions</p>
          <%= render_analyses_chart(
                :ca_transactions_timeline,
                chart_id: "analyses-chart-ca-transactions",
                extra_class: "analyses-chart--fill analyses-chart--timeline",
                aria_label: "Évolution du CA encaissé et des transactions par jour"
              ) %>
        </div>
      <% else %>
        <div class="col-12">
          <p class="small text-body-secondary mb-2">Évolution CA &amp; transactions</p>
          <%= render_analyses_chart(
                :ca_transactions_timeline,
                chart_id: "analyses-chart-ca-transactions",
                extra_class: "analyses-chart--fill analyses-chart--timeline",
                aria_label: "Évolution du CA encaissé et des transactions par jour"
              ) %>
        </div>
      <% end %>
    </div>

    <div class="row g-3 align-items-stretch mt-1">
      <% if show_tx_doughnut %>
        <div class="col-lg-5">
          <p class="small text-body-secondary mb-2">Répartition location / vente</p>
          <div class="d-flex justify-content-center">
            <%= render_analyses_chart(
                  :transactions_doughnut,
                  extra_class: "analyses-chart--compact",
                  aria_label: "Répartition des transactions location et vente"
                ) %>
          </div>
        </div>
        <div class="col-lg-7">
          <p class="small text-body-secondary mb-2">
            Panier moyen &amp; articles / commande
            <span class="text-body-tertiary">— jours sans commande exclus</span>
          </p>
          <%= render_analyses_chart(
                :ca_ratios_timeline,
                chart_id: "analyses-chart-ca-ratios",
                extra_class: "analyses-chart--fill analyses-chart--timeline",
                aria_label: "Évolution du panier moyen et des articles par commande"
              ) %>
        </div>
      <% else %>
        <div class="col-12">
          <p class="small text-body-secondary mb-2">
            Panier moyen &amp; articles / commande
            <span class="text-body-tertiary">— jours sans commande exclus</span>
          </p>
          <%= render_analyses_chart(
                :ca_ratios_timeline,
                chart_id: "analyses-chart-ca-ratios",
                extra_class: "analyses-chart--fill analyses-chart--timeline",
                aria_label: "Évolution du panier moyen et des articles par commande"
              ) %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
