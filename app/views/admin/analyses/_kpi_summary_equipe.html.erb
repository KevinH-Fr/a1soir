<% totals = analyses_equipe_kpi_totals %>
<% top = analyses_equipe_top_ca_row %>
<div class="row row-cols-2 row-cols-lg-4 g-2 g-sm-3">
  <%= render "kpi_card",
        title: "CA équipe",
        value: "#{analyses_donut_amount_label(totals[:ca])} €",
        trend_metric: :equipe_ca,
        hint: "#{totals[:vendeurs]} vendeur#{totals[:vendeurs] > 1 ? "s" : ""}",
        hint2: nil %>

  <%= render "kpi_card",
        title: "Commandes",
        value: totals[:commandes],
        trend_metric: :equipe_commandes,
        hint: "Sur la période filtrée",
        hint2: nil %>

  <%= render "kpi_card",
        title: "Devis",
        value: totals[:devis],
        trend_metric: :equipe_devis,
        hint: "Créés sur la période",
        hint2: nil %>

  <%= render "kpi_card",
        title: (totals[:vendeurs] == 1 ? "Vendeur" : "Meilleur CA"),
        value: (top ? top[:profile] : "—"),
        hint: (top ? "#{analyses_donut_amount_label(top[:ca])} €" : "Aucun CA sur la période"),
        hint2: (top ? "#{top[:commandes]} commandes · #{top[:articles].to_i} articles" : nil) %>
</div>
