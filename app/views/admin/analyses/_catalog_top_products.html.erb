<%# Top produits — deux classements (qté / CA), bascule via Stimulus parent. %>
<% rows_qty = @catalog_top_products_by_qty.presence || @catalog_top_products %>
<% rows_ca = @catalog_top_products_by_ca.presence || @catalog_top_products %>
<div class="analyses-catalog-top">
  <% if rows_qty.blank? && rows_ca.blank? %>
    <p class="small text-muted mb-0">Aucune ligne article sur cette période.</p>
  <% else %>
    <div class="analyses-catalog-top__table-wrap">
      <table class="table analyses-catalog-top__table align-middle mb-0">
        <thead>
          <tr>
            <th scope="col" class="analyses-catalog-top__rank">#</th>
            <th scope="col" class="analyses-catalog-top__col-product">Produit</th>
            <th scope="col" class="analyses-catalog-top__col-qty text-end">Qté</th>
            <th scope="col" class="analyses-catalog-top__col-split d-none d-md-table-cell">
              <span class="analyses-catalog-top__split-label">
                <span class="analyses-catalog-top__swatch analyses-catalog-top__swatch--loc" aria-hidden="true"></span>
                Location
                <span class="text-body-secondary">/</span>
                <span class="analyses-catalog-top__swatch analyses-catalog-top__swatch--vente" aria-hidden="true"></span>
                Vente
              </span>
            </th>
            <th scope="col" class="analyses-catalog-top__col-ca text-end">CA lignes</th>
          </tr>
        </thead>
        <tbody data-analyses-segment-toggle-target="panel" data-segment-key="qty">
          <%= render partial: "admin/analyses/catalog_top_products_rows", locals: { rows: rows_qty } %>
        </tbody>
        <tbody class="d-none" data-analyses-segment-toggle-target="panel" data-segment-key="ca">
          <%= render partial: "admin/analyses/catalog_top_products_rows", locals: { rows: rows_ca } %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
