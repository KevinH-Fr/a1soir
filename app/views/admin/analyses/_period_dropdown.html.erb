<% selected_range = analyses_period_selected_range %>
<div class="dropdown analyses-period-dropdown">
  <button type="button"
          class="analyses-period-trigger dropdown-toggle"
          id="analysesPeriodDropdown"
          data-bs-toggle="dropdown"
          data-bs-auto-close="outside"
          aria-expanded="false"
          aria-label="Choisir la période d'analyse">
    <span class="d-inline-flex align-items-center gap-2 min-w-0">
      <span class="analyses-period-trigger__icon" aria-hidden="true">
        <i class="bi bi-calendar3"></i>
      </span>
      <span class="text-truncate"><%= analyses_period_preset_label %></span>
    </span>
  </button>
  <ul class="dropdown-menu analyses-period-menu shadow-sm"
      style="min-width: min(100vw - 2rem, 18rem)"
      aria-labelledby="analysesPeriodDropdown">
    <% analyses_quick_period_presets.each do |label, range| %>
      <% debut, fin = range %>
      <% active = selected_range == [debut, fin] %>
      <li>
        <%= link_to label,
                    admin_analyses_index_path(analyses_period_params(debut: debut, fin: fin)),
                    class: class_names("dropdown-item analyses-period-menu__item", "analyses-period-menu__item--active" => active) %>
      </li>
    <% end %>
    <li><hr class="dropdown-divider analyses-period-menu__divider"></li>
    <li class="analyses-period-menu__custom">
      <p class="analyses-period-menu__custom-label">Plage personnalisée</p>
      <%= form_tag url_for, method: :get, class: "analyses-period-menu__form" do %>
        <div class="analyses-period-menu__fields">
          <%= date_field_tag :debut, params[:debut],
                             class: "form-control form-control-sm analyses-period-menu__date",
                             aria: { label: "Date de début" } %>
          <span class="analyses-period-menu__arrow" aria-hidden="true">
            <i class="bi bi-arrow-right"></i>
          </span>
          <%= date_field_tag :fin, params[:fin],
                             class: "form-control form-control-sm analyses-period-menu__date",
                             aria: { label: "Date de fin" } %>
        </div>
        <%= hidden_field_tag :vue, analyses_vue %>
        <% analyses_filter_params(include_dates: false).except(:vue).each do |key, value| %>
          <%= hidden_field_tag key, value if value.present? %>
        <% end %>
        <%= submit_tag "Appliquer", class: "btn btn-sm btn-outline-secondary w-100" %>
      <% end %>
    </li>
  </ul>
</div>
