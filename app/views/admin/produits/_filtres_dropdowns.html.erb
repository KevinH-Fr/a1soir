<% id_suffix = local_assigns[:id_suffix] %>
<% always_show_label = local_assigns.fetch(:always_show_label, false) %>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Catalogue",
        icon: "bi bi-shop",
        param_key: :filter_catalogue,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_catalogue)),
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

<% if @costume_catalogue %>
  <div class="min-w-0">
    <%= filter_dropdown(
          label: "Rubrique",
          icon: "bi bi-bookmark",
          param_key: :filter_rubrique,
          collection: @rubrique_costumes,
          model: RubriqueCostume,
          current_params: listing_params_with_search(produits_filter_params(exclude: :filter_rubrique)),
          all_label: "Toutes les rubriques",
          columns: 2,
          id_suffix: id_suffix,
          always_show_label: always_show_label
        ) %>
  </div>
<% else %>
  <div class="min-w-0">
    <%= filter_dropdown(
          label: "Catégorie",
          icon: "bi bi-layers",
          param_key: :filter_categorie,
          collection: @categorie_produits,
          model: CategorieProduit,
          current_params: listing_params_with_search(produits_filter_params(exclude: :filter_categorie)),
          all_label: "Toutes les catégories",
          columns: 2,
          id_suffix: id_suffix,
          always_show_label: always_show_label
        ) %>
  </div>
<% end %>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Type",
        icon: "bi bi-tag",
        param_key: :filter_type_produit,
        collection: @type_produits,
        model: TypeProduit,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_type_produit)),
        all_label: "Tous les types",
        columns: 2,
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Taille",
        icon: "bi bi-rulers",
        param_key: :filter_taille,
        collection: @tailles,
        model: Taille,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_taille)),
        all_label: "Toutes les tailles",
        columns: 2,
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Couleur",
        icon: "bi bi-palette",
        param_key: :filter_couleur,
        collection: @couleurs,
        model: Couleur,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_couleur)),
        all_label: "Toutes les couleurs",
        columns: 2,
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Statut",
        icon: "bi bi-bookmark-check",
        param_key: :filter_statut,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_statut)),
        id_suffix: id_suffix,
        always_show_label: always_show_label,
        multiple: true,
        keep_label: false
      ) %>
</div>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Fournisseur",
        icon: "bi bi-buildings",
        param_key: :filter_fournisseur,
        collection: @fournisseurs,
        model: Fournisseur,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_fournisseur)),
        columns: 2,
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

<div class="min-w-0">
  <%= filter_dropdown(
        label: "Prix",
        icon: "bi bi-currency-euro",
        param_key: :filter_prix,
        current_params: listing_params_with_search(produits_filter_params(exclude: :filter_prix)),
        id_suffix: id_suffix,
        always_show_label: always_show_label
      ) %>
</div>

